VITE_WORKER_API_URL=https://api.ccup.us.ci
# Enable only for a demo build. Each target phone must already be registered.
VITE_DEMO_ROLE_SWITCH_ENABLED=true
VITE_DEMO_ELDER_PHONE=13800000001
VITE_DEMO_FAMILY_PHONE=13900000001
VITE_DEMO_VILLAGER_PHONE=13900000002
