# Local Edge Function secrets. Copy to supabase/functions/.env for local use.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=本地supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=本地supabase-secret-key
FRONTEND_ORIGIN=http://localhost:5173
# Demo role switch is local-only by default. Set true only for a demo deployment.
DEMO_ROLE_SWITCH_ENABLED=false
# Optional fixed demo phone numbers; keep them unique from real accounts.
DEMO_ELDER_PHONE=13800000001
DEMO_FAMILY_PHONE=13900000001
DEMO_VILLAGER_PHONE=13900000002
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
