# ============================================================
#  乡音心伴 · 环境变量模板
#  复制本文件为 .env 后按需修改
# ============================================================

# ==================== 数据库模式（二选一） ====================
#
#  sqlite   → 用本地 SQLite 文件，数据随项目一起跑（一键部署 / 演示用，零配置）
#  postgres → 连 Supabase 云库（团队共用同一个数据库）
#
#  不填则自动判断：DB_HOST 为空或 localhost → sqlite；远程地址 → postgres
#
DB_MODE=sqlite


# ==================== 仅 postgres 模式需要填以下 6 项 ====================
# （用 Supabase 的 Connect → Direct → Session pooler 里那串信息）
#
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.你的项目ref          ← 注意是「带点的一长串」，不是单独的 postgres
# DB_PASSWORD=你的数据库密码
# DB_NAME=postgres
# DB_SSLMODE=require


# ==================== SQLite 模式可选 ====================
# 自定义 SQLite 文件路径（默认：项目目录下的 xiangyin.db）
# SQLITE_PATH=./xiangyin.db


# ==================== 大模型（可选） ====================
# 留空则自动降级为本地演示话术，功能照常可跑
# 任意 OpenAI 兼容接口均可：
#   DeepSeek  : https://api.deepseek.com/v1   deepseek-chat
#   中转站     : https://apidock.ai/v1         gpt-5.5
#   豆包       : https://ark.cn-beijing.volces.com/api/v3
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20
AI_MAX_RETRIES=2


# ==================== 其它 ====================
FLASK_ENV=production
FLASK_DEBUG=False
